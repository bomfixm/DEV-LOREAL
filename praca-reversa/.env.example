# Modelo de configuração. Copie para .env (ou rode `npm run env:local`, que gera
# senhas aleatórias). Nunca versione o .env nem coloque senhas reais aqui.

# desenvolvimento | teste | producao. Sem valor, a API assume producao
# (cookies Secure e seed de demonstração bloqueado).
APP_AMBIENTE=desenvolvimento

# Bancos PostgreSQL separados para desenvolvimento, testes automatizados e E2E.
DATABASE_URL=postgresql://praca:TROQUE_ESTA_SENHA@127.0.0.1:5433/praca_reversa_dev
DATABASE_URL_TESTE=postgresql://praca:TROQUE_ESTA_SENHA@127.0.0.1:5433/praca_reversa_teste
DATABASE_URL_E2E=postgresql://praca:TROQUE_ESTA_SENHA@127.0.0.1:5433/praca_reversa_e2e

# Segredo da aplicação (mínimo 32 caracteres). Usado em HMAC do hash de
# idempotência, para que pedidos com senha nunca fiquem com hash simples no banco.
APP_SEGREDO=TROQUE_ESTE_SEGREDO_POR_UM_VALOR_ALEATORIO

# Pasta do cluster PostgreSQL local gerenciado por `npm run db:iniciar`.
PG_DADOS=.dados/postgres

# Cookie de sessão só por HTTPS. Em http://127.0.0.1 local use false.
COOKIE_SEGURO=false

# Endereço pelo qual os aparelhos da operação abrem o sistema; vai no QR das
# etiquetas (somente protocolo, host e porta). Obrigatório em produção. Sem
# valor fora de produção: http://127.0.0.1:5173 no `npm run dev` e
# http://127.0.0.1:<PORT> no `npm start` — endereços locais, que um celular
# não abre. Para testar com celular na mesma rede, use o IP do computador
# (ex.: http://192.168.0.10:3000) e HOST=0.0.0.0 somente se a rede permitir.
# APP_URL_PUBLICA=https://praca.exemplo.interno

# Opcionais (padrões entre parênteses):
# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info
# SESSAO_INATIVIDADE_MINUTOS=120
# SESSAO_DURACAO_MAXIMA_HORAS=12

# Limites da importação de CSV/XLSX e da exportação da busca (padrões):
# IMPORTACAO_ARQUIVO_MAX_MB=5
# IMPORTACAO_LINHAS_MAX=5000
# IMPORTACAO_COLUNAS_MAX=50
# IMPORTACAO_CELULA_MAX_CARACTERES=1000
# IMPORTACAO_DESCOMPACTADO_MAX_MB=50
# IMPORTACAO_ZIP_ENTRADAS_MAX=300
# IMPORTACAO_TEMPO_MAX_S=20
# BUSCA_EXPORTACAO_MAX_LINHAS=5000
# CLAIMS_ORDEM_PADRAO=PRIORIDADE
# CLAIMS_ANEXO_MAX_MB=5

# "Seleção cliente — teste" (simulação do cliente; não movimenta estoque). Desativada,
# as rotas e as permissões da funcionalidade somem. O acesso é só por concessão
# explícita no vínculo (Administração de acesso), nunca por perfil.
# SELECAO_CLIENTE_TESTE=ativada

# Planilha automática e proteção (docs/IMPLANTACAO.md). Sem PLANILHA_DESTINO a
# planilha fica só no servidor (.dados/planilha) e a tela mostra "Não configurado".
# Destino independente: s3://<bucket>/<prefixo> (armazenamento S3 compatível) ou
# pasta:\\servidor\compartilhamento (outra máquina). Pasta deste servidor não conta.
# PLANILHA_AUTOMATICA=ativada
# PLANILHA_DESTINO=s3://copias-praca-reversa/operacao
# PLANILHA_DESTINO_DESCRICAO=Armazenamento da empresa > Praça Reversa (acesso restrito)
# Credenciais só aqui, no servidor (nunca no front, no repositório ou no log):
# PROTECAO_S3_ENDPOINT=https://s3.sa-east-1.amazonaws.com
# PROTECAO_S3_REGIAO=sa-east-1
# PROTECAO_S3_ESTILO=caminho
# PROTECAO_S3_CHAVE_ACESSO=
# PROTECAO_S3_SEGREDO=
# PLANILHA_PASTA_LOCAL=.dados/planilha
# PLANILHA_INTERVALO_S=5
# PLANILHA_AGRUPAR_S=10
# PLANILHA_ESPERA_MAXIMA_S=60
# PLANILHA_ALVO_S=30
# PLANILHA_ATRASO_S=120
# PLANILHA_RECONCILIAR_MIN=60
# PLANILHA_VERSOES_MANTER=50
# PLANILHA_DIARIAS_DIAS=30
# PLANILHA_PRE_SUBSTITUICAO_DIAS=30
# PLANILHA_MOVIMENTOS_POR_ARQUIVO=1000000
# PLANILHA_CONCESSAO_MIN=10
# PLANILHA_PROTEGER_SUBSTITUICAO=ativada

# Backup completo automático (trabalhador da API; manual: npm run protecao:backup).
# Destino externo padrão: o mesmo da planilha, sob backups/.
# BACKUP_AUTOMATICO=ativada
# BACKUP_INTERVALO_HORAS=24
# BACKUP_DESTINO=.dados/backups
# BACKUP_DESTINO_EXTERNO=s3://backups-praca-reversa/operacao
# BACKUP_DESTINO_EXTERNO_DESCRICAO=Armazenamento da empresa > backups (só administradores)
# BACKUP_RESPONSAVEL=Nome do responsável técnico
# BACKUP_MANTER=14
# BACKUP_DIARIOS_DIAS=30
# BACKUP_PRE_SUBSTITUICAO_DIAS=30
# BACKUP_PRAZO_HORAS=26
# BACKUP_VARIAVEL_BANCO=DATABASE_URL
# RESTAURACAO_PRAZO_DIAS=35

# Netlify Functions + Neon (docs/PUBLICACAO-NETLIFY-NEON.md). Valores reais só no
# painel da Netlify (runtime) ou no terminal de quem roda as migrações.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require
# DIRECT_URL=postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/BANCO?sslmode=require
# DB_POOL_MAX=3
# DB_CONEXAO_TIMEOUT_MS=15000
