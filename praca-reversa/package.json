{
  "name": "praca-reversa",
  "version": "0.1.0",
  "private": true,
  "description": "Praça Reversa: paletes, conteúdo físico e devoluções da operação DHL / L'Oréal.",
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": "^24.11.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "env:local": "node scripts/criar-env-local.mjs",
    "db:iniciar": "node scripts/banco-local.mjs iniciar",
    "db:parar": "node scripts/banco-local.mjs parar",
    "db:status": "node scripts/banco-local.mjs status",
    "db:gerar": "npm run db:gerar -w @praca-reversa/api",
    "db:migrar": "npm run db:migrar -w @praca-reversa/api",
    "db:semear-demo": "npm run db:semear-demo -w @praca-reversa/api",
    "admin:criar": "npm run admin:criar -w @praca-reversa/api --",
    "inventario:carregar": "npm run inventario:carregar -w @praca-reversa/api --",
    "paletes:numeracao": "npm run paletes:numeracao -w @praca-reversa/api --",
    "paletes:corrigir": "npm run paletes:corrigir -w @praca-reversa/api --",
    "planilha:exemplo": "npm run planilha:exemplo -w @praca-reversa/api",
    "backup:criar": "node scripts/recuperacao/criar-backup.mjs",
    "backup:restaurar": "node scripts/recuperacao/restaurar-backup.mjs",
    "backup:rotina": "node scripts/recuperacao/rotina-backup.mjs",
    "backup:teste-restauracao": "node scripts/recuperacao/teste-restauracao.mjs",
    "guia:gerar": "node scripts/gerar-guia-operador.mjs",
    "build:contracts": "npm run build -w @praca-reversa/contracts",
    "dev": "npm run build:contracts && npm run db:gerar && concurrently --kill-others-on-fail --names api,web --prefix-colors red,yellow \"npm run dev -w @praca-reversa/api\" \"npm run dev -w @praca-reversa/web\"",
    "build": "npm run build:contracts && npm run build -w @praca-reversa/api && npm run build -w @praca-reversa/web",
    "build:netlify": "npm run build:contracts && npm run db:gerar && npm run build -w @praca-reversa/web",
    "start": "node apps/api/dist/server.js",
    "typecheck": "npm run build:contracts && npm run typecheck --workspaces && tsc -p tsconfig.json --noEmit",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js .",
    "test": "npm run build:contracts && npm run db:gerar && vitest run",
    "test:unidade": "npm run build:contracts && npm run db:gerar && vitest run --project unidade",
    "test:e2e": "npm run build && playwright test --grep-invert @captura",
    "capturas": "npm run build && playwright test --grep @captura",
    "icones": "node scripts/gerar-icones.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "concurrently": "10.0.5",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsqr": "1.4.0",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
